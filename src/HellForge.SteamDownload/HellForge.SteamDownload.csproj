<Project Sdk="Microsoft.NET.Sdk">
  <!-- Setup's download of the supported build from Valve's servers, for the player's own Steam account (docs/steam-download.md).
       Its own assembly so the NativeAOT programs (HellForge.Session, HellForge.LocalBackend), which reference
       HellForge.Core, never carry SteamKit2. Referenced by the launcher, the CLI and the tests. -->
  <ItemGroup><ProjectReference Include="../HellForge.Core/HellForge.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <!-- Steam's network protocol: LGPL-2.1-only, used as a separate, replaceable DLL. Its own dependencies are protobuf-net
         (Apache-2.0), ZstdSharp.Port (MIT) and System.IO.Hashing (MIT). -->
    <PackageReference Include="SteamKit2" Version="3.5.0" />
    <!-- The sign-in QR code: MIT -->
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>
</Project>
