<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HellForge.Launcher"
        xmlns:core="clr-namespace:HellForge.Core;assembly=HellForge.Core"
        x:Class="HellForge.Launcher.MainWindow"
        Title="HellForge"
        Icon="/Assets/hellforge.ico"
        Width="1180" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="fonts:Inter#Inter, $Default">
  <Grid>
    <Grid ColumnDefinitions="236,*">

      <!-- Sidebar: title, navigation, session state -->
      <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="22,26,22,26">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Image Source="/Assets/hellforge-icon.png" Width="52" Height="52" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="21" FontWeight="Black" LetterSpacing="1.5">
                  <Run Text="HELL" /><Run Text="FORGE" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
                <TextBlock Text="离线 HELLDIVERS 2" Classes="muted" FontSize="11" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <Border Height="2" Background="{StaticResource AccentBrush}" Margin="0,20,0,0" Opacity="0.85" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,24" Spacing="8">
            <!-- Support and news: the HellForge Discord server -->
            <Button x:Name="DiscordButton" Classes="discord" HorizontalAlignment="Left" Margin="-6,0,0,14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="15" Height="15"
                          Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
                <TextBlock Text="Discord" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="会话" Classes="h2" Margin="0" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border x:Name="SidebarDot" Classes="dot" Background="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="SidebarState" Text="空闲" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="VersionText" Classes="muted" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox x:Name="Nav" Classes="nav" SelectedIndex="0">
            <ListBoxItem Content="01   开始" />
            <ListBoxItem Content="02   档案" />
            <ListBoxItem Content="03   模组" />
            <ListBoxItem Content="04   控制台" />
            <ListBoxItem Content="05   设置" />
          </ListBox>
        </DockPanel>
      </Border>

      <Panel Grid.Column="1" Margin="40,34,40,32">

        <!-- PLAY -->
        <Grid x:Name="PlayPage" RowDefinitions="Auto,Auto,Auto,*,Auto">
          <StackPanel>
            <TextBlock Text="部署" Classes="eyebrow" />
            <TextBlock Text="本地会话" Classes="h1" />
          </StackPanel>

          <Border Grid.Row="1" Classes="card" Margin="0,24,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <Border x:Name="StatusDot" Classes="dot" Width="16" Height="16" CornerRadius="8"
                      Background="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,5,18,0" />
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock x:Name="StatusText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                <SelectableTextBlock x:Name="FailureText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" IsVisible="False" />
                <TextBlock x:Name="HintText" Classes="muted" TextWrapping="Wrap" />
                <ProgressBar x:Name="BootProgress" Classes="detail" Minimum="0" Maximum="1000" IsVisible="False" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="StepsCard" Grid.Row="2" Classes="card" Margin="0,16,0,0" Padding="28,24">
            <Grid x:Name="StepsGrid" />
          </Border>

          <!-- Inline "new profile" form; takes the place of the steps while open -->
          <Border x:Name="NewProfileForm" Grid.Row="2" Classes="card" Margin="0,16,0,0" Padding="24,18" IsVisible="False">
            <StackPanel Spacing="10">
              <TextBlock Text="新建档案" Classes="h2" Margin="0" />
              <Grid ColumnDefinitions="*,12,*,12,Auto,8,Auto">
                <TextBox x:Name="NewProfileName" Watermark="名称，例如 my-run" MaxLength="32" VerticalContentAlignment="Center" />
                <ComboBox x:Name="TemplateCombo" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:ProfileTemplate">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="badge" IsVisible="{Binding IsDev}">
                          <TextBlock Text="DEV" />
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="CancelProfileButton" Grid.Column="4" Classes="ghost" Content="取消" />
                <Button x:Name="CreateProfileButton" Grid.Column="6" Classes="primary" Content="创建" />
              </Grid>
              <TextBlock x:Name="TemplateDescription" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock x:Name="NewProfileError" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Bottom" Spacing="4" Margin="0,0,24,4">
              <TextBlock x:Name="PlatformNote" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" IsVisible="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Width="340" Spacing="10">
              <TextBlock Text="档案" Classes="h2" Margin="0" />
              <Grid ColumnDefinitions="*,8,Auto">
                <ComboBox x:Name="ProfileCombo" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:LocalProfile">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="badge" IsVisible="{Binding IsDev}">
                          <TextBlock Text="DEV" />
                        </Border>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="NewProfileButton" Grid.Column="2" Classes="ghost" Content="新建档案" />
              </Grid>
              <Button x:Name="PlayButton" Classes="play" Width="340" Margin="0,6,0,0">
                <TextBlock x:Name="PlayLabel" Text="开始" LetterSpacing="6" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- PROFILE -->
        <DockPanel x:Name="ProfilePage" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
            <TextBlock Text="绝地潜兵" Classes="eyebrow" />
            <TextBlock x:Name="ProfileTitle" Text="default" Classes="h1" />
            <TextBlock x:Name="ProfileNote" Classes="muted" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*">
            <Button x:Name="OpenProfileButton" Classes="ghost" Content="打开档案文件夹" />
            <SelectableTextBlock x:Name="ProfilePathText" Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                                 FontSize="12" TextWrapping="Wrap" Margin="16,0,0,0" />
          </Grid>
          <ScrollViewer>
          <StackPanel Margin="0,0,0,16">
          <UniformGrid Columns="3" VerticalAlignment="Top" Margin="0,0,-16,0">
            <UniformGrid.Styles>
              <Style Selector="UniformGrid > Border.card">
                <Setter Property="Margin" Value="0,0,16,16" />
              </Style>
            </UniformGrid.Styles>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="经验值" Classes="h2" Margin="0" />
                <TextBlock x:Name="XpText" Classes="stat" Text="-" />
                <TextBlock Text="总经验值" Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="舰船名称" Classes="h2" Margin="0" />
                <TextBlock x:Name="ShipText" Classes="stat" Text="-" />
                <TextBlock Text="舰船名称的词序号" Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="物品栏" Classes="h2" Margin="0" />
                <TextBlock x:Name="InventoryText" Classes="stat" Text="-" />
                <TextBlock Text="存档中的物品" Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="新手引导状态" Classes="h2" Margin="0" />
                <TextBlock x:Name="OnboardingStateText" Classes="stat" Text="-" />
                <TextBlock Text="新兵引导进度" Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="新手引导标记" Classes="h2" Margin="0" />
                <TextBlock x:Name="OnboardingFlagsText" Classes="stat" Text="-" />
                <TextBlock x:Name="OnboardingFlagsHex" Classes="muted" FontSize="12" FontFamily="{StaticResource MonoFont}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="模板" Classes="h2" Margin="0" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock x:Name="TemplateText" Classes="stat" FontSize="24" Text="-" />
                  <Border x:Name="TemplateBadge" Classes="badge" VerticalAlignment="Center" IsVisible="False">
                    <TextBlock Text="DEV" />
                  </Border>
                </StackPanel>
                <TextBlock x:Name="TemplateCaption" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Classes="card" Margin="0,0,0,16">
            <StackPanel Spacing="10">
              <TextBlock Text="游戏设置" Classes="h2" Margin="0" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="把你在正式 HELLDIVERS 2 里设置好的选项（画面、音频、显示、玩法）复制到这个档案，也可以顺便从 Steam 导入按键绑定。新档案会在第一次游玩时获得一次；在正式游戏里改过设置后可以再次导入。档案自身的设置会保留，所以「撤销导入」能把它们恢复回去。进度、存档和配装都不受影响。" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox x:Name="ImportControlsBox" Content="同时导入按键绑定" IsChecked="True" VerticalAlignment="Center" />
                <Button x:Name="ImportSettingsButton" Classes="primary" Content="从 HELLDIVERS 2 导入" />
                <Button x:Name="UndoImportButton" Classes="ghost" Content="撤销导入" />
              </StackPanel>
              <TextBlock x:Name="ImportSettingsStatus" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="WeaponLevelsCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="10">
              <TextBlock Text="武器等级" Classes="h2" Margin="0" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="每把武器的精通等级（0 = 从未使用）。等级 1 给予它的默认配件，此后每升一级就解锁对应的内容。模组新增的武器沿用它们所复制的武器。保存进档案，供下次会话使用。" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="所有武器都设为等级" VerticalAlignment="Center" />
                <NumericUpDown x:Name="AllLevelsInput" Minimum="0" Maximum="25" Increment="1" FormatString="0" Value="25" Width="120" />
                <Button x:Name="SetAllLevelsButton" Classes="ghost" Content="全部设置" />
                <Button x:Name="SaveLevelsButton" Classes="primary" Content="保存等级" />
              </StackPanel>
              <TextBlock x:Name="WeaponLevelsStatus" FontSize="12" TextWrapping="Wrap" />
              <UniformGrid x:Name="WeaponLevelsList" Columns="3" />
            </StackPanel>
          </Border>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- MODS -->
        <DockPanel x:Name="ModsPage" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="军械库" Classes="eyebrow" />
            <TextBlock Text="模组" Classes="h1" />
            <TextBlock x:Name="ModsSummary" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,16,0,0">
            <Button x:Name="OpenModsButton" Classes="ghost" Content="打开模组文件夹" />
            <Button x:Name="RefreshModsButton" Grid.Column="1" Classes="ghost" Content="刷新" Margin="10,0,0,0" />
            <Button x:Name="AddModsButton" Grid.Column="2" Classes="ghost" Content="添加模组…" Margin="10,0,0,0" />
            <SelectableTextBlock x:Name="ModsDigestText" Grid.Column="3" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" />
          </Grid>
          <ScrollViewer>
            <StackPanel x:Name="ModsList" Spacing="12" Margin="0,0,18,0" />
          </ScrollViewer>
        </DockPanel>

        <!-- CONSOLE -->
        <DockPanel x:Name="ConsolePage" IsVisible="False">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="本地后端" Classes="eyebrow" />
              <TextBlock Text="控制台" Classes="h1" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
              <CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True" />
              <Button x:Name="ClearButton" Classes="ghost" Content="清空" />
              <Button x:Name="ConsoleLogsButton" Classes="ghost" Content="打开会话日志" />
              <Button x:Name="ShareLogsButton" Classes="ghost" Content="把日志保存到桌面" Margin="10,0,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12" Margin="0,10,0,0"
                     Text="当前会话的实时后端请求。2xx 为绿色，501（尚未实现）为红色。" />
          <Border Background="#0A0B0D" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="0,8">
            <ListBox x:Name="ConsoleList" Classes="console" FontFamily="{StaticResource MonoFont}" FontSize="12.5">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:LogLine">
                  <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>

        <!-- SETTINGS / ABOUT -->
        <ScrollViewer x:Name="SettingsPage" IsVisible="False">
          <StackPanel Spacing="16" Margin="0,0,18,0">
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="系统" Classes="eyebrow" />
              <TextBlock Text="设置与关于" Classes="h1" />
            </StackPanel>

            <Border x:Name="InstallCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock Text="安装" Classes="h2" Margin="0" />
                <TextBlock x:Name="InstallText" TextWrapping="Wrap" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="「检查并修复」会把游戏文件与受支持的版本比对，把缺失或损坏的文件从 Steam 复制过来，并重新放置网络封锁和快捷方式。" />
                <Button x:Name="RepairButton" Classes="ghost" Content="检查并修复" HorizontalAlignment="Left" Margin="0,6,0,0" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="「卸载」会移除 HellForge 的网络封锁（Windows 会请求权限）和快捷方式，然后在启动器关闭后删除这个安装文件夹。你原本的 HELLDIVERS 2 和 Steam 不会被改动。" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="UninstallButton" Classes="ghost" Content="卸载 HellForge…" />
                  <TextBlock x:Name="UninstallText" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="UninstallConfirm" IsVisible="False" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                  <StackPanel Spacing="10">
                    <TextBlock x:Name="UninstallWarning" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button x:Name="UninstallConfirmButton" Classes="danger" Content="卸载并删除全部内容" />
                      <Button x:Name="UninstallCancelButton" Classes="ghost" Content="取消" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="多人联机" Classes="h2" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="和同样运行 HellForge 的 Steam 好友一起玩：你的后端起你游戏的大厅和会话，并通过 Steam 与他们的后端通信（仅限好友）。好友需要安装相同的玩法模组（见「模组」）。两个开关都需要打开，且对下次会话生效。" />
                <CheckBox x:Name="LocalPlayFabBox" Content="本地 PlayFab" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="把游戏的 PlayFab 登录和档案请求指向本地后端，而不是 playfabapi.com。无论哪种方式，复制出的游戏都保持无法联网。" />
                <CheckBox x:Name="SdkShimsBox" Content="大厅和会话经由 Steam 好友" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="在会话期间用 HellForge 的替身 DLL 替换复制出的 PlayFab Party 和 Lobby DLL；它们永远不会连接到 PlayFab，而是通过 Steam 网络与好友的后端通信。每次调用都会记入会话文件夹的日志。" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="银河战争" Classes="h2" />
                <RadioButton x:Name="WarLiveRadio" GroupName="war" Content="跟随实时银河战争" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0"
                           Text="在游戏开始前以及游玩时每 5 分钟，本地后端会从社区 API 镜像 api.helldivers2.dev 只读地读取当前战争状态（行星、战役、解放度）。HellForge 和游戏本身都不会连接 Arrowhead 的服务器。没有网络时使用上次获取的数据。" />
                <RadioButton x:Name="WarFrozenRadio" GroupName="war" Content="HellForge 的冻结战争" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0"
                           Text="2026 年 10 月 14 日真实战争的快照，内置于 HellForge：每次会话都是相同的行星和战役，完全离线。" />
                <RadioButton x:Name="WarOpenRadio" GroupName="war" Content="所有行星开放" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0"
                           Text="除了超级地球以外的每颗行星都是可以降落的解放战役。冻结战争中归超级地球所有的行星会划归前线朝向它们的敌方阵营，因此每个阵营大约占据三分之一的银河。基于冻结战争构建，所以在每台 PC 上、离线时都完全一致。对下次会话生效。" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="启动选项" Classes="h2" />
                <TextBox x:Name="LaunchOptionsBox" Watermark="例如 --use-d3d11" MaxLength="1024" VerticalContentAlignment="Center" />
                <TextBlock x:Name="LaunchOptionsProblem" Classes="muted" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" IsVisible="False" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="游戏命令行选项，与 Steam 的启动选项相同：例如 --use-d3d11 会让游戏以 DirectX 11 启动。Steam 的 &quot;%command% --use-d3d11&quot; 写法也可以。HellForge 自己的选项会排在前面。对下次会话生效。" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="疑难解答" Classes="h2" />
                <CheckBox x:Name="EngineLogBox" Content="引擎日志" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="以开启自身日志的方式启动游戏（--log-to-file），并把该日志复制到会话日志里，这样「把日志保存到桌面」也会包含它。有助于排查加入或连接失败的原因。对下次会话生效。" />
                <CheckBox x:Name="CrashDumpBox" Content="崩溃转储" Margin="0,6,0,0" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="如果游戏崩溃，就把完整的内存转储（约 1 GB）写入会话日志，用于反馈崩溃问题。转储包含游戏当时内存里的内容（例如你的 Steam 账号名）：只发送给你信任的人。除非需要，否则保持关闭。对下次会话生效。" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="路径" Classes="h2" />
                <Grid x:Name="PathsGrid" ColumnDefinitions="150,*" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                  <Button x:Name="SettingsLogsButton" Classes="ghost" Content="打开会话日志" />
                  <Button x:Name="OpenRootButton" Classes="ghost" Content="打开项目文件夹" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="关于" Classes="h2" Margin="0" />
                <TextBlock TextWrapping="Wrap"
                           Text="HellForge 让 HELLDIVERS 2 连接本机的本地后端运行，而不是官方服务器。" />
                <TextBlock TextWrapping="Wrap" Classes="muted"
                           Text="网络封锁让复制出的游戏无法联网。它只覆盖复制出的游戏自己的程序，所以不影响正式游戏和 Steam。「设置 > 安装 > 卸载 HellForge」会把它一起移除。" />
                <TextBlock TextWrapping="Wrap" Classes="muted"
                           Text="每次启动前都会进行 Steam 所有权检查，所以 Steam 必须正在运行，并登录到拥有该游戏（或通过 Steam 家庭共享获得）的账号。" />
                <TextBlock TextWrapping="Wrap" Classes="muted"
                           Text="个人性质、离线的研究项目。与 Arrowhead Game Studios 或 Sony Interactive Entertainment 没有关联，也未获其认可。" />
                <TextBlock x:Name="PlatformText" Classes="muted" FontSize="12" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- SETUP: replaces the other pages until the installation's game is copied; Settings opens it to repair -->
        <DockPanel x:Name="SetupPage" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="安装" Classes="eyebrow" />
            <TextBlock x:Name="SetupTitle" Text="设置 HellForge" Classes="h1" />
            <TextBlock x:Name="SetupIntro" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="安装程序会把你 Steam 库中的 HELLDIVERS 2 复制到这个文件夹（约 24 GB），并封锁这个副本的联网。你原本的游戏和 Steam 保持原样。请保持 Steam 运行并已登录。" />
          </StackPanel>
          <!-- The buttons stay in view; only the steps and options scroll. -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SetupPauseButton" Classes="ghost" Content="暂停复制" IsVisible="False" />
            <Button x:Name="SetupBackButton" Classes="ghost" Content="返回" IsVisible="False" />
            <Button x:Name="SetupStartButton" Classes="primary" Content="开始安装" />
          </StackPanel>
          <ScrollViewer>
          <StackPanel Spacing="16" Margin="0,0,18,0">
            <Border Classes="card">
              <StackPanel x:Name="SetupSteps" Spacing="10" />
            </Border>
            <Border x:Name="DownloadCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock Text="通过 Steam 下载受支持的版本" Classes="h2" Margin="0" />
                <TextBlock x:Name="DownloadIntro" Classes="muted" TextWrapping="Wrap" />
                <Button x:Name="OpenConsoleButton" Content="打开 Steam 控制台" Classes="primary" HorizontalAlignment="Left" />
                <StackPanel x:Name="DownloadCommands" Spacing="6" />
                <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="1000" Height="8" />
                <TextBlock x:Name="DownloadText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <CheckBox x:Name="DeleteDownloadBox" IsChecked="True" />
              </StackPanel>
            </Border>
            <Border x:Name="CopyCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock Text="游戏文件" Classes="h2" Margin="0" />
                <ProgressBar x:Name="CopyProgress" Minimum="0" Maximum="1000" Height="8" />
                <TextBlock x:Name="CopyText" Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="选项" Classes="h2" Margin="0" />
                <CheckBox x:Name="DesktopShortcutBox" Content="桌面快捷方式" IsChecked="True" />
                <CheckBox x:Name="StartMenuShortcutBox" Content="开始菜单快捷方式" IsChecked="True" />
                <CheckBox x:Name="ImportBox" Content="从本机早先的 HellForge 安装导入游戏设置和存档" IsChecked="True" IsVisible="False" />
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Panel>
    </Grid>

    <!-- Confirmation shown when the window is closed during a session -->
    <Grid x:Name="ConfirmOverlay" Background="#B0000000" IsVisible="False">
      <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel Spacing="12">
          <TextBlock x:Name="ConfirmTitle" Text="会话正在运行" FontSize="19" FontWeight="Bold" />
          <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Classes="muted"
                     Text="游戏会话正在运行。要停止它并关闭游戏吗？" />
          <StackPanel x:Name="ConfirmButtons" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ConfirmCancel" Classes="ghost" Content="继续游玩" />
            <Button x:Name="ConfirmStop" Classes="danger" Content="停止并关闭" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
