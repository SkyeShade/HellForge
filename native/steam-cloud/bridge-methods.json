            ]
          },
          "adjust": [
            "eLobbyType"
          ],
          "review": "a public lobby's data can be read by anyone who searches: the broker logs the type asked for and makes a Public lobby Friends only while Play with strangers is off (broker_bridge.c)"
        },
        "JoinLobby": {
          "mode": "call",
          "review": "the game's co-op join: after the PlayFab join, a joiner joins the host's own Steam lobby (census 2026-10-24); any lobby by id, as the game does without HellForge, and that lobby learns this player's SteamID"
